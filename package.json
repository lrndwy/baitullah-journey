{
  "name": "baitullah-journey",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "boundaries": "turbo run boundaries",
    "db:generate": "pnpm --filter @app/core db:generate && pnpm --filter @app/api db:generate",
    "db:migrate": "pnpm --filter @app/core db:migrate && pnpm --filter @app/api db:migrate",
    "docker:dev": "docker compose -f docker/docker-compose.yml up --build",
    "docker:prod": "docker compose -f docker/docker-compose.prod.yml up --build -d"
  },
  "devDependencies": {
    "turbo": "^2.11.11",
    "typescript": "^7.0.2"
  }
}
