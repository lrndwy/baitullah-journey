# ── Copy to `.env` and adjust. Never commit a real `.env`. ────────────────────

NODE_ENV=development
PORT=3000

# Postgres. Inside docker compose this is overridden to the `postgres` service.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/app
DATABASE_POOL_MAX=10
REDIS_URL=redis://localhost:6379

# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=dev-only-access-secret-change-me
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# Google OAuth. Leave all three blank to disable Google sign-in entirely; the
# API then exposes only the local sign-in path. The callback URL must match the
# one registered in the Google Cloud console byte for byte.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

WEB_ORIGIN=http://localhost:3001
CORS_ORIGINS=

# Module switches — see README "Adding and removing modules".
# MODULES_ENABLED=            # allow-list; wins over the deny-list when set
# MODULES_DISABLED=users      # comma separated module names to turn off

LOG_LEVEL=info
AUDIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX=300

# Passwordless local sign-in (legacy). Keep false — use email/password instead.
AUTH_DEV_LOGIN=false

# Default administrator (created once on API boot if the email is new).
BOOTSTRAP_ADMIN_EMAIL=admin@baitullahjourney.id
BOOTSTRAP_ADMIN_PASSWORD=ChangeMeNow1!
BOOTSTRAP_ADMIN_NAME=Administrator

# Password reset codes.
PASSWORD_RESET_TTL_SECONDS=600
PASSWORD_RESET_MAX_ATTEMPTS=5

# Password policy, enforced on every password write: self-service reset, an
# authenticated change, and an administrator creating an account.
#   LOW    = length only
#   MEDIUM = length + 3 character classes
#   STRONG = length + 4 classes + dictionary/sequence/identity checks
# PASSWORD_MIN_LENGTH raises the level's own floor; it never lowers it.
PASSWORD_POLICY=STRONG
PASSWORD_MIN_LENGTH=12
# Days before a password must be replaced. 0 disables rotation.
PASSWORD_MAX_AGE_DAYS=0

# Account lockout after consecutive failed sign-ins. 0 disables the lock and
# leaves only the per-IP rate limiter in front of the login route.
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# Mail. Without SMTP_URL, mail is written to the API log — which is how local
# development reads reset codes.
# SMTP_URL=smtp://user:pass@smtp.example.com:587
MAIL_FROM=no-reply@example.com

# S3-compatible object storage (RustFS, MinIO, MaxIO). Leave blank to run
# without it; the file and backup endpoints then answer 503.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=app
S3_FORCE_PATH_STYLE=true
# Host the browser resolves for presigned URLs (differs from S3_ENDPOINT in Docker).
S3_PUBLIC_ENDPOINT=http://localhost:9000
# S3_PUBLIC_BASE_URL=https://cdn.example.com

# ── Web image. Read at container start, not baked in at build time. ──────────
# The browser-facing API origin. Changing this needs a container restart, not a
# rebuild — which is what makes one image portable across environments.
API_PUBLIC_URL=http://localhost:3000
# Used by the Next server for server-side fetches (branding). Inside Docker this
# is the compose service name; outside it, the same URL as above.
# API_INTERNAL_URL=http://api:3000

# Build-time fallback only. Applied when the container starts with no
# API_PUBLIC_URL set at all.
NEXT_PUBLIC_API_URL=http://localhost:3000
